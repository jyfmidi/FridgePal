# Fridge Pal environment template. Copy to .env; never commit the resulting file.

# Keep this value stable after the first deployment. It also names the MySQL volume.
COMPOSE_PROJECT_NAME=fridgital

# Host exposure. 127.0.0.1 is the safe default.
# For direct server-IP access, use 0.0.0.0 and restrict APP_PORT to trusted source IPs.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Backend database URL (SQLite default for local runs; compose overrides with MySQL).
DATABASE_URL=sqlite:///./fridgital.db

# MySQL container settings used by Compose.
# Use a long URL-safe password because it is interpolated into DATABASE_URL.
MYSQL_DATABASE=fridgital
MYSQL_USER=fridgital
MYSQL_PASSWORD=replace-with-a-long-random-url-safe-password

# Recipe structuring LLM, OpenAI-compatible (leave key empty in fixture mode).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Recipe source search API (leave key empty in fixture mode).
SEARCH_API_KEY=
SEARCH_BASE_URL=https://api.tavily.com

# Recipe provider: fixture (deterministic, offline) or live.
RECIPE_PROVIDER_MODE=fixture

APP_TIMEZONE=Asia/Shanghai
APP_DEFAULT_LOCALE=en

# Set false to start without the deterministic demo inventory.
SEED_DEMO_DATA=true

# Auth (required for multi-user mode). The app refuses to start without these.
# JWT secret must be at least 32 characters. Generate with: openssl rand -hex 32
FRIDGE_PAL_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
# Password for the built-in demo account (at least 8 characters).
FRIDGE_PAL_DEMO_PASSWORD=demo12345
# Set true in production (requires HTTPS).
FRIDGE_PAL_COOKIE_SECURE=false
# Auth brute-force protection: requests per minute per client address. 0 disables.
AUTH_LOGIN_RATE_PER_MINUTE=10
AUTH_REGISTER_RATE_PER_MINUTE=5
# Fixed administrator account (Food Library and app settings management).
# The app refuses to start without a valid admin password.
FRIDGE_PAL_ADMIN_USERNAME=admin
FRIDGE_PAL_ADMIN_PASSWORD=change-me-to-an-admin-password
